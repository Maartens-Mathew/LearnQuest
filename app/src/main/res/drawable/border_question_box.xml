<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background color -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/> <!-- Inner background color (white) -->
            <corners android:radius="12dp"/> <!-- Corner radius -->
        </shape>
    </item>

    <!-- Border color and width -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="3dp"
                android:color= "@color/greenTint" /> <!-- Dark green border -->
            <corners android:radius="12dp"/> <!-- Match corner radius with background -->
        </shape>
    </item>

</layer-list>
