<?xml version="1.0" encoding="utf-8"?>
<layout >
    <data>
        <variable
            name="user"
            type="com.example.learnquest.model.user.User" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/register_background"
        tools:context=".LoginRegister.RegisterStudent">


        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Register Student"
            android:textColor="@color/white"
            android:textSize="34sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="410dp"
            android:layout_height="326dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="36dp"
            android:layout_marginEnd="16dp"
            android:background="#39FDFCFC"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.516"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView">

            <EditText
                android:id="@+id/txt_FirstName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:autoText="false"
                android:background="@color/white"
                android:ems="15"
                android:focusable="true"

                android:hint="First Name"
                android:inputType="text"
                android:text="@={user.firstName}"
                android:textSize="24sp" />

            <EditText
                android:id="@+id/txt_Surname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:autoText="false"
                android:background="@color/white"
                android:ems="15"
                android:hint="Surname"
                android:inputType="text"
                android:text="@={user.lastName}"
                android:textSize="24sp" />

            <EditText
                android:id="@+id/txt_ID"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:background="@color/white"
                android:text="@={user.nationalID}"
                android:ems="15"
                android:hint="ID"
                android:inputType="number"
                android:textSize="24sp" />

            <EditText
                android:id="@+id/txt_EmailAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:autoText="false"
                android:background="@color/white"
                android:ems="15"
                android:hint="E-mail"
                android:inputType="textEmailAddress"
                android:text="@={user.email}"
                android:textSize="24sp" />

            <EditText
                android:id="@+id/txt_Username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:autoText="false"
                android:background="@color/white"
                android:ems="15"
                android:hint="Username"
                android:inputType="text"
                android:text="@={user.username}"
                android:textSize="24sp" />

            <EditText
                android:id="@+id/txt_Password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:autoText="false"
                android:background="@color/white"
                android:ems="15"
                android:hint="Enter Password"
                android:inputType="textPassword"
                android:text="@={user.password}"
                android:textSize="24sp" />

            <EditText
                android:id="@+id/txt_RePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:autoText="false"
                android:background="@color/white"
                android:ems="15"
                android:hint="Re-enter Password"
                android:inputType="textPassword"
                android:textSize="24sp" />
        </LinearLayout>

        <Button
            android:id="@+id/button"
            style="@android:style/Theme.Material.NoActionBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/button_background"
            android:onClick="ConfirmStudent"
            android:text="Confirm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/button2"
            style="@android:style/Theme.Material.NoActionBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/button_background"
            android:onClick="ReturnToMain"
            android:text="Main Menu"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/imageButton"
            android:layout_width="58dp"
            android:layout_height="62dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:onClick="ResetFields"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout"
            app:srcCompat="@drawable/reset_button" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>